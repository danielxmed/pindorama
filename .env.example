# Pindorama — environment variables.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# NEVER commit a real HF_TOKEN. Hooks will reject diffs containing one.

# HuggingFace Hub token (required for Stage 7 dataset push).
# Generate at https://huggingface.co/settings/tokens (write scope).
HF_TOKEN=

# Optional: override the default scratch root on Alpine.
# If unset, src/pindorama/paths.py derives /scratch/alpine/$USER/pindorama.
# PINDORAMA_SCRATCH=/scratch/alpine/your-identikey/pindorama

# Optional: override the persistent home for the cleaned corpus.
# Defaults to /projects/$USER/pindorama once pinned in paths.py.
# PINDORAMA_PERSISTENT=/projects/your-identikey/pindorama

# Optional: target HuggingFace dataset repo.
# Defaults to tylerxdurden/Pindorama.
# HF_DATASET_REPO=tylerxdurden/Pindorama
